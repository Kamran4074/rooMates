# Backend API base URL (client-side accessible, hence NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public site URL - canonical links, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client ID (public, safe to expose in browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay public key (safe to expose in browser; secret key stays in backend only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
