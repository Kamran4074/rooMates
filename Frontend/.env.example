# Backend API base URL (client-side accessible, hence NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional, dev only: your Wi-Fi IP so others on the same router can open
# http://<IP>:3000. Then also set NEXT_PUBLIC_API_URL=http://<IP>:5000 and add
# http://<IP>:3000 to the backend's CORS_ORIGIN. (Google sign-in won't work on an IP.)
DEV_LAN_HOST=

# Public site URL - canonical links, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client ID (public, safe to expose in browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

