# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=0

# CORS - frontend origin allowed to call this API
# Comma-separated if more than one, e.g. http://localhost:3000,https://roomates.vercel.app
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Neon) - owner connection, used ONLY by migrations (DDL rights)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PostgreSQL (Neon) - least-privilege app_user connection, used by the running app so RLS actually applies
APP_DB_PASSWORD=
APP_DATABASE_URL=postgresql://app_user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Google OAuth (only the client ID is needed - ID tokens are verified, no redirect flow)
GOOGLE_CLIENT_ID=

# Brevo (transactional email)
BREVO_API_KEY=
EMAIL_FROM_NAME=RooMates
EMAIL_FROM_ADDRESS=
CONTACT_INBOX=
