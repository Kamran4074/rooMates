# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=0

# CORS - frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Neon) - owner connection, used ONLY by migrations (DDL rights)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PostgreSQL (Neon) - least-privilege app_user connection, used by the running app so RLS actually applies
APP_DB_PASSWORD=
APP_DATABASE_URL=postgresql://app_user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis
REDIS_URL=redis://localhost:6379

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=RooMates <onboarding@resend.dev>
CONTACT_INBOX=
